# Runtime
NODE_ENV=development
PORT=4001

# Auth service-owned PostgreSQL database
DATABASE_URL=postgresql://sentinel:sentinel_dev_password@postgres:5432/sentinel_auth?schema=public

# Use separate, strong values. JWT_ACCESS_SECRET must be shared with services that verify access tokens.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated frontend/gateway origins. Wildcards are intentionally unsupported.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

