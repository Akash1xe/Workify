NODE_ENV=development
PORT=4003
DATABASE_URL=postgresql://sentinel:sentinel_dev_password@postgres:5432/sentinel_catalog?schema=public

# Must match auth-service because human dashboard requests use its access JWTs.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sentinelai-auth
JWT_AUDIENCE=sentinelai-api

# Real synchronous membership checks are sent here. Never point this at a database.
ORGANIZATION_SERVICE_URL=http://organization-service:4002
MEMBERSHIP_TIMEOUT_MS=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

