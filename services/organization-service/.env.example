NODE_ENV=development
PORT=4002
DATABASE_URL=postgresql://sentinel:sentinel_dev_password@postgres:5432/sentinel_org?schema=public

# Must exactly match auth-service JWT_ACCESS_SECRET so this service can verify access tokens.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sentinelai-auth
JWT_AUDIENCE=sentinelai-api

INVITATION_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

