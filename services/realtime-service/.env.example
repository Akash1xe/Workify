NODE_ENV=development
PORT=4005
REDIS_URL=redis://localhost:6379
# Must exactly match auth-service so socket handshakes can verify access tokens.
JWT_ACCESS_SECRET=replace-with-the-same-32-plus-character-access-secret
JWT_ISSUER=sentinelai-auth
JWT_AUDIENCE=sentinelai-api
ORGANIZATION_SERVICE_URL=http://localhost:4002
INCIDENT_SERVICE_URL=http://localhost:4004
DEPENDENCY_TIMEOUT_MS=3000
CORS_ORIGINS=http://localhost:3000
