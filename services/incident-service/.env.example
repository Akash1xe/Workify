ORGANIZATION_SERVICE_URL=http://localhost:4002
CATALOG_SERVICE_URL=http://localhost:4003
DEPENDENCY_TIMEOUT_MS=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
